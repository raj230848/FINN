# Copy this file to frontend/.env.local for local development.
BACKEND_URL=http://127.0.0.1:8000
# Match FINN_API_TOKEN in the project-root .env when enabled.
FINN_API_TOKEN=

# Required for hosting the live personal desk (not the static Sites demo).
FINN_PUBLIC_MODE=false
# Generate separate private values. Never use NEXT_PUBLIC_ prefixes.
FINN_ACCESS_TOKEN=
FINN_SESSION_SECRET=
