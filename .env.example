# Copy to .env in the project root. No key is required for extractive research.
# Omit DATABASE_URL locally: the default resolves to backend/data/finn.db
# independently of your working directory. Override for a persistent host disk:
# DATABASE_URL=sqlite:////var/lib/finn/finn.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional shared token: required for every /api request except /api/health when set.
FINN_API_TOKEN=
ENABLE_SCHEDULER=false
SYNC_INTERVAL_MINUTES=60
# Server-only Next.js proxy settings; never expose the API token to the browser.
BACKEND_URL=http://127.0.0.1:8000

# For a hosted live backend: require the server-only API token above.
PUBLIC_DEPLOYMENT=false
FILING_LOOKBACK_DAYS=7
# Bounded, complete primary-PDF imports (never silently truncate pages).
DOCUMENT_MAX_PAGES=3000
DOCUMENT_MAX_DOWNLOAD_BYTES=60000000
DOCUMENT_MAX_TEXT_CHARS=12000000
DOCUMENT_MAX_PAGE_CHARS=200000
DOCUMENT_MAX_CHUNKS=20000
DOCUMENT_EXTRACT_TIMEOUT_SECONDS=90
# Optional Web Push: run scripts/configure-push.py locally to create keys.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
